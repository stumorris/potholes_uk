{
  "name": "potholes-uk",
  "version": "0.1.0",
  "private": true,
  "description": "Report potholes, see every recorded pothole in the UK on a live map, and learn who is liable for vehicle damage.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "ingest": "node --disable-warning=ExperimentalWarning src/ingest/cli.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "express": "^5.3.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "multer": "^2.4.0"
  }
}
